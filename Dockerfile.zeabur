FROM public.ecr.aws/docker/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# The current OB runtime uses the reproducible upstream lockfile. Haven's
# gateway/xinchao sidecars still use the root-level compatibility modules.
COPY requirements.lock.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements.lock.txt

# Xinchao is bundled as an internal sidecar. Node 20 matches its supported runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Root-level files are retained for Haven's Gateway, raw archive and Xinchao
# adapter. The Brain process itself is the current upstream src/server.py.
COPY *.py ./
COPY src ./src
COPY frontend ./frontend
COPY resources ./resources
COPY scripts ./scripts
COPY tools ./tools
COPY docs/adr ./docs/adr
COPY xinchao/package.json ./xinchao/package.json
COPY xinchao/configs ./xinchao/configs
COPY xinchao/src ./xinchao/src
COPY VERSION ./VERSION
COPY config.example.yaml ./config.default.yaml
COPY config.example.yaml ./config.yaml
COPY entrypoint_zeabur.py ./entrypoint_zeabur.py

RUN chmod +x scripts/*.sh 2>/dev/null || true

ENV OMBRE_TRANSPORT=streamable-http \
    OMBRE_BUCKETS_DIR=/data \
    OMBRE_STATE_DIR=/state \
    OMBRE_PROXY_PORT=9000 \
    OMBRE_GATEWAY_PORT=8010 \
    OMBRE_XINCHAO_PORT=18110

VOLUME ["/data", "/state"]
EXPOSE 9000

CMD ["python", "entrypoint_zeabur.py"]